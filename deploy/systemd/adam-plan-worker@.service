[Unit]
Description=ADAM plan worker %i
After=network-online.target redis-server.service

[Service]
User=datascience
WorkingDirectory=/home/datascience/ADAM-Web/backend
Environment=REDIS_URL=redis://localhost:6379/1
Environment=PLAN_QUEUE_NAME=meal-plans
ExecStart=/home/datascience/ADAM-Web/.adam/bin/python -m services.plan_worker --workers 1
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
MemoryMax=2G

[Install]
WantedBy=multi-user.target
