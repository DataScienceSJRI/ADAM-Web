[Unit]
Description=ADAM WhatsApp jobs worker (next-day meal preview)
After=network-online.target

[Service]
User=datascience
WorkingDirectory=/home/datascience/ADAM-Web/backend
ExecStart=/home/datascience/ADAM-Web/.adam/bin/python -m services.whatsapp_worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
